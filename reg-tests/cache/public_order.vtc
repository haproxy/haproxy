varnishtest "A \"public\" directive does not cancel the ones forbidding storage"

# "private", "no-store" or "no-cache" forbid a shared cache from storing or
# reusing a response, whatever other directives are present. A "public"
# directive placed after them, possibly in another Cache-Control header added
# by another layer, must not make the response cacheable.

feature ignore_unknown_macro

server s1 {
    rxreq
    expect req.url == "/a"
    txresp -hdr "Cache-Control: private, public, max-age=60" -bodylen 10
    rxreq
    expect req.url == "/a"
    txresp -hdr "Cache-Control: private, public, max-age=60" -bodylen 11

    rxreq
    expect req.url == "/b"
    txresp -hdr "Cache-Control: no-store" -hdr "Cache-Control: public, max-age=60" -bodylen 20
    rxreq
    expect req.url == "/b"
    txresp -hdr "Cache-Control: no-store" -hdr "Cache-Control: public, max-age=60" -bodylen 21

    rxreq
    expect req.url == "/c"
    txresp -hdr "Cache-Control: public, max-age=60" -bodylen 30
} -start

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        http-request cache-use c1
        http-response cache-store c1
        http-response set-header X-Cache-Hit %[res.cache_hit]
        default_backend be

    backend be
        server s1 ${s1_addr}:${s1_port}

    cache c1
        total-max-size 4
} -start

client c1 -connect ${h1_fe_sock} {
    txreq -url "/a"
    rxresp
    expect resp.bodylen == 10
    txreq -url "/a"
    rxresp
    expect resp.bodylen == 11
    expect resp.http.X-Cache-Hit == 0

    txreq -url "/b"
    rxresp
    expect resp.bodylen == 20
    txreq -url "/b"
    rxresp
    expect resp.bodylen == 21
    expect resp.http.X-Cache-Hit == 0

    # "public" alone remains cacheable
    txreq -url "/c"
    rxresp
    expect resp.bodylen == 30
    txreq -url "/c"
    rxresp
    expect resp.bodylen == 30
    expect resp.http.X-Cache-Hit == 1
} -run
