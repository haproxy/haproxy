varnishtest "Legacy filter declarations and filter-* directives cannot be mixed"

feature ignore_unknown_macro

# The two modes can be selected independently on different proxies. Multiple
# declarations within one mode are allowed, including instances-mode defaults.
haproxy h1 -conf-OK {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults plain
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend legacy_fe from plain
        bind "fd@${legacy_fe}"
        filter trace
        filter trace
        default_backend instances_be

    backend instances_be from plain
        filter-config trace id a
        filter-config trace id b enabled
        filter-enable trace/a
        filter-disable trace/b
        filter-sequence request trace/b:before(trace/a)

    backend legacy_be from plain
        filter trace

    defaults instances
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"
        filter-config trace id inherited
        filter-enable trace/inherited

    frontend instances_fe from instances
        bind "fd@${instances_fe}"
        filter-config trace id local
        filter-enable trace/local
        filter-sequence response trace/local:before(trace/inherited)
        default_backend legacy_be
}

# Implicit cache filters populate both legacy configs and instances. They do
# not select a mode: either explicit syntax can follow an implicit declaration.
haproxy h2 -conf-OK {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    cache store
        total-max-size 1

    backend implicit_then_legacy
        http-request cache-use store
        filter cache store

    backend implicit_then_instances
        http-request cache-use store
        filter-config trace id test
        filter-enable trace/test
        filter-disable cache-store/store
        filter-sequence response cache-store/store:before(trace/test)

    backend implicit_then_explicit_instance
        http-request cache-use store
        filter-config cache-store id store enabled
}

# Reject every directive in either declaration order, in frontends, backends
# and listen sections. Also reject legacy filters after inherited directives.
# Listen inheritance is already forbidden and is covered in defaults-inheritance.
# Response-only instances must be detected as well as bidirectional ones.

# filter-config (bidirectional)
# frontend, legacy-first.
haproxy h3 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters

    frontend px from filters
        filter trace
        filter-config trace id test
}

# frontend, instances-first.
haproxy h4 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters

    frontend px from filters
        filter-config trace id test
        filter trace
}

# frontend, inherited.
haproxy h5 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters
        filter-config trace id test

    frontend px from filters
        filter trace
}

# backend, legacy-first.
haproxy h6 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters

    backend px from filters
        filter trace
        filter-config trace id test
}

# backend, instances-first.
haproxy h7 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters

    backend px from filters
        filter-config trace id test
        filter trace
}

# backend, inherited.
haproxy h8 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters
        filter-config trace id test

    backend px from filters
        filter trace
}

# listen, legacy-first.
haproxy h9 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
    defaults filters

    listen px from filters
        filter trace
        filter-config trace id test
}

# listen, instances-first.
haproxy h10 -conf-BAD {'filter' and 'filter-*' directives cannot be used together in the same proxy} {
