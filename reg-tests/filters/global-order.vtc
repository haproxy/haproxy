varnishtest "Global filter instance order is independent of request/response orders"

feature ignore_unknown_macro

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    cache store
        total-max-size 1

    defaults filters
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"
        # Deliberately not in global class order. Include request-only,
        # response-only and bidirectional classes, and multiple instances.
        filter-config bwlim-out id download default-limit 1m default-period 1s
        filter-config cache-store id store
        filter-config trace id b
        filter-config bwlim-in id upload default-limit 1m default-period 1s
        filter-config trace id a

    frontend baseline from filters
        bind "fd@${baseline}"
        http-request return status 200

    frontend reordered from filters
        bind "fd@${reordered}"
        http-request return status 200
        filter-enable trace
        filter-disable trace/b
        # Global moves can cross classes which have no common channel side.
        # Subsequent moves must still find already-reordered instances.
        filter-sequence global bwlim-out/download:before(trace/a) trace/b:after(cache-store)
        filter-sequence global bwlim-in/upload:after(cache-store/store) cache-store/store:before(trace/a)
        filter-sequence request trace/b:before(trace/a)
        filter-sequence response trace/a:after(cache-store/store)

    defaults plain
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend empty from plain
        bind "fd@${empty}"
        http-request return status 200

    frontend single from plain
        bind "fd@${single}"
        filter-config trace id only
        http-request return status 200
} -start

# Inherited global sequences are applied to the child's instances, including
# local overrides, without changing either channel's parsing/class order.
haproxy h2 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults ordered
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence global trace/b:before(trace/a)

    frontend fe from ordered
        bind "fd@${fe}"
        filter-config trace id b enabled
        filter-config trace id c
        http-request return status 200

    frontend single from ordered
        bind "fd@${single}"
        http-request return status 200
} -start

# Reject self-references in each order.
haproxy h4 -conf-BAD {a loop is detected} {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence global trace/a:before(trace/a)
}

haproxy h5 -conf-BAD {a loop is detected} {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence request trace/a:before(trace/a)
}

haproxy h6 -conf-BAD {a loop is detected} {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence response trace/a:before(trace/a)
}

# Keep the trees valid after a rejected cycle. The final sequence in each case
# exercises a subsequent lookup before error cleanup.
haproxy h7 -conf-BAD {a loop is detected} {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence global trace/a:before(trace/b) trace/b:before(trace/a) trace/a:before(trace)
}

haproxy h8 -conf-BAD {a loop is detected} {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence request trace/a:before(trace/b) trace/b:before(trace/a) trace/a:before(trace)
}

haproxy h9 -conf-BAD {a loop is detected} {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        filter-config trace id a
        filter-config trace id b
        filter-sequence response trace/a:before(trace/b) trace/b:before(trace/a) trace/a:before(trace)
}
