varnishtest "fc_pp_tlv on the SSL TLV sent by send-proxy-v2-ssl"
feature cmd "$HAPROXY_PROGRAM -cc 'feature(OPENSSL)'"
feature ignore_unknown_macro

# The SSL TLV (0x20) sent by send-proxy-v2-ssl is binary: its <client> and
# <verify> fields hold \0 bytes when the client connection is not TLS.
# fc_pp_tlv(0x20) must return all its bytes, so that it can be converted
# with hex or relayed.

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    listen sender
        bind "fd@${feS}"
        server r ${h1_feR_addr}:${h1_feR_port} send-proxy-v2-ssl set-proxy-v2-tlv-fmt(0xE1) %[str("text")]

    listen receiver
        bind "fd@${feR}" accept-proxy
        http-request return status 200 hdr ssl-tlv "%[fc_pp_tlv(0x20),hex]" hdr custom-tlv "%[fc_pp_tlv(0xE1)]"
} -start

client c1 -connect ${h1_feS_sock} {
    txreq -url "/"
    rxresp
    expect resp.status == 200
    expect resp.http.custom-tlv == "text"
    # <client> = 0x00 (no TLS), <verify> = 0x00000000
    expect resp.http.ssl-tlv == "0000000000"
} -run
