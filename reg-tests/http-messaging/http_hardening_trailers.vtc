varnishtest "HTTP hardening checks on HTTP/1 and HTTP/2 trailers"

# Each trailer-related http-hardening check gets its own profile, applied to
# a bind line for request trailers, or to a server line for response
# trailers, with both HTTP/1 and HTTP/2 on the receiving side. The "off"
# profile has everything disabled and serves as the reference, and the "hdr"
# profile enables header checks which must not affect trailers.
#
# vtest cannot parse HTTP/1 trailers, so the request trailers are forwarded
# by the proxy in HTTP/1 to the "obs" frontend of the same instance, which
# waits for the whole chunked message in TCP mode, then switches to HTTP and
# replies with the list of trailer and header fields it received. The
# response trailers are delivered to HTTP/2 clients which can parse them,
# and the response body is waited for so that a rejected trailer results in
# a 502 instead of an aborted response.
#
# Rejected request trailers result in a 400 in HTTP/1 and in a stream error in
# HTTP/2.

feature cmd "$HAPROXY_PROGRAM -cc 'version_atleast(3.5-dev10)'"
feature ignore_unknown_macro

server s_res0_h1 {
	rxreq
	txresp -nolen -hdr "transfer-encoding: chunked" -body "2\r\nok\r\n0\r\nt-a: 1\r\nt_b: 2\r\nx-c: 3\r\n\r\n"
} -start

server s_res0_h2 {
	rxpri
	stream 0 {
		txsettings
		rxsettings
		txsettings -ack
	} -run

	stream 1 {
		rxreq
		txresp -status 200 -nostrend
		txdata -data "ok" -nostrend
		txresp -noadd -hdr "t-a" "1" -hdr "t_b" "2" -hdr "x-c" "3"
	} -run
} -start

server s_res1_h1 {
	rxreq
	txresp -nolen -hdr "transfer-encoding: chunked" -body "2\r\nok\r\n0\r\nt-a: 1\r\nt_b: 2\r\nx-c: 3\r\n\r\n"
} -start

server s_res1_h2 {
	rxpri
	stream 0 {
		txsettings
		rxsettings
		txsettings -ack
	} -run

	stream 1 {
		rxreq
		txresp -status 200 -nostrend
		txdata -data "ok" -nostrend
		txresp -noadd -hdr "t-a" "1" -hdr "t_b" "2" -hdr "x-c" "3"
	} -run
} -start

server s_res2_h1 {
	rxreq
	txresp -nolen -hdr "transfer-encoding: chunked" -body "2\r\nok\r\n0\r\nt-a: 1\r\nt_b: 2\r\nx-c: 3\r\n\r\n"
} -start

server s_res2_h2 {
