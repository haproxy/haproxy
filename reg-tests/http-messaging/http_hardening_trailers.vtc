	} -run

	stream 1 {
		txreq -req POST -url / -scheme http -hdr ":authority" "a" -hdr "x-h" "1" -nostrend
		txreq -noadd -hdr "t-a" "1" -hdr "t_b" "2" -hdr "x-c" "3"
