} -run

client c_s_unreg -connect ${h1_s_unreg_sock} {
	txpri
	stream 0 {
		txsettings
		rxsettings
		txsettings -ack
		rxsettings
		expect settings.ack == true
	} -run

	stream 1 {
		txreq -req GET -url / -scheme http -hdr ":authority" "a"
		rxresp
		expect resp.status == 200
		expect resp.http.x-foo == <undef>
		expect resp.http.foo == "2"
		expect resp.http.xa == "3"
	} -run
} -run

client c_s_ctl_ok -connect ${h1_s_ctl_ok_sock} {
	txpri
	stream 0 {
		txsettings
		rxsettings
		txsettings -ack
		rxsettings
		expect settings.ack == true
	} -run

	stream 1 {
		txreq -req GET -url / -scheme http -hdr ":authority" "a"
