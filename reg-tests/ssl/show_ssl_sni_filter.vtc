#REGTEST_TYPE=bug

# This reg-test checks the "-f <frontend>" filter of the "show ssl sni" CLI
# command:
#  - with no filter, every frontend's SNI entries are listed
#  - "-f <existing frontend>" restricts the output to that frontend only
#  - "-f <unknown frontend>" must report an error
#
# See GitHub issue #3466 (CID 1660133 / CID 1664029): the "not found" case
# was never actually detected (the loop variable used for the check can't be
# NULL once the search loop over "main_proxies" completes, matched or not),
# so an unknown "-f" name silently fell back to displaying the first proxy
# in the list instead of returning "Couldn't find the specified frontend!".

varnishtest "Test the 'show ssl sni -f <frontend>' CLI option"
feature cmd "$HAPROXY_PROGRAM -cc 'version_atleast(3.2-dev2)'"
feature cmd "$HAPROXY_PROGRAM -cc 'feature(OPENSSL)'"
feature ignore_unknown_macro

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif
    .if !ssllib_name_startswith(AWS-LC)
        tune.ssl.default-dh-param 2048
    .endif
        stats socket "${tmpdir}/h1/stats" level admin

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    # frontend's default SNI entry comes from the certificate's CN/SAN:
    # www.test1.com
    frontend fe1
        bind "${tmpdir}/fe1.sock" ssl crt ${testdir}/certs/common.pem

    # frontend's default SNI entry comes from the certificate's CN/SAN:
    # localhost
    frontend fe2
        bind "${tmpdir}/fe2.sock" ssl crt ${testdir}/certs/ecdsa.pem
} -start

# no filter: both frontends must be listed
haproxy h1 -cli {
    send "show ssl sni"
    expect ~ ".*www.test1.com"
    send "show ssl sni"
    expect ~ ".*localhost"
}

# "-f fe1": only fe1's entry must be listed
haproxy h1 -cli {
    send "show ssl sni -f fe1"
    expect ~ ".*www.test1.com"
    send "show ssl sni -f fe1"
    expect !~ ".*localhost"
}

# "-f fe2": only fe2's entry must be listed
haproxy h1 -cli {
    send "show ssl sni -f fe2"
    expect ~ ".*localhost"
    send "show ssl sni -f fe2"
    expect !~ ".*www.test1.com"
}

# "-f <unknown frontend>" must report an error instead of silently falling
# back to the first frontend of the list (GH #3466 / CID 1664029)
haproxy h1 -cli {
    send "show ssl sni -f does-not-exist"
    expect ~ "Couldn't find the specified frontend!"
}
