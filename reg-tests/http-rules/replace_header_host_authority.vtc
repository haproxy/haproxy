varnishtest "replace-header on host keeps the URI authority in sync"

# When the host header is rewritten on a request whose URI carries an
# authority (all H2 and H3 requests, and H1 absolute-form ones), the
# authority is updated with the new value. That value is built by the rule
# into a trash chunk, while growing the header block may need a defrag of
# the message, which itself uses a trash chunk. The authority must still
# be built from the right value.
#
# Here a large header is removed first to leave a hole in the message, and
# the host header is then made five times longer, which only fits after a
# defrag. The filler header size is swept so that the free space left at
# the tail of the message is on both sides of the size of the new value.

feature ignore_unknown_macro

server s1 -repeat 7 {
    rxreq
    expect req.url ~ "^http://(h{388}\\.example\\.org){5}/1[01][0-9]{3}$"
    expect req.http.host ~ "^(h{388}\\.example\\.org){5}$"
    txresp
} -start

haproxy h1 -conf {
    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        http-request del-header x-junk
        http-request replace-header host (.*) \\1\\1\\1\\1\\1
        default_backend be

    backend be
        server s1 ${s1_addr}:${s1_port}
} -start

client c1 -connect ${h1_fe_sock} {
    txreq -url "http:.example.org/10000" -hdr "host: .example.org" -hdrlen x-junk 3000 -hdrlen x-fill 10000
    rxresp
    expect resp.status == 200
} -run

client c2 -connect ${h1_fe_sock} {
    txreq -url "http:.example.org/10200" -hdr "host: .example.org" -hdrlen x-junk 3000 -hdrlen x-fill 10200
    rxresp
    expect resp.status == 200
} -run

client c3 -connect ${h1_fe_sock} {
    txreq -url "http:.example.org/10400" -hdr "host: .example.org" -hdrlen x-junk 3000 -hdrlen x-fill 10400
    rxresp
    expect resp.status == 200
} -run

client c4 -connect ${h1_fe_sock} {
    txreq -url "http:.example.org/10600" -hdr "host: .example.org" -hdrlen x-junk 3000 -hdrlen x-fill 10600
    rxresp
    expect resp.status == 200
} -run

client c5 -connect ${h1_fe_sock} {
    txreq -url "http:.example.org/10800" -hdr "host: .example.org" -hdrlen x-junk 3000 -hdrlen x-fill 10800
    rxresp
    expect resp.status == 200
