varnishtest "QUIC: NEW_CONNECTION_ID must not reference a retired CID"

#REGTEST_TYPE=bug
#REGTEST_EXTRA=qclient

feature ignore_unknown_macro
feature cmd "python3 --version"
feature cmd "python3 -c 'import cryptography'"

# QUIC is not supported with USE_QUIC_OPENSSL_COMPAT nor with wolfSSL.
feature cmd "$HAPROXY_PROGRAM -cc 'feature(QUIC) && !feature(QUIC_OPENSSL_COMPAT) && !feature(OPENSSL_WOLFSSL)'"

# A NEW_CONNECTION_ID frame used to store pointers to the CID and the
# stateless reset token of its quic_connection_id. A RETIRE_CONNECTION_ID
# frees that object at once, while a NEW_CONNECTION_ID frame built for it
# may still be queued, in flight, or duplicated later for a retransmission:
# the frame was then built from freed memory.
#
# A client triggers it by retiring sequence numbers 1 and 2 in the same
# packet: the second RETIRE frees the quic_connection_id allocated for the
# first one, whose NEW_CONNECTION_ID frame is not sent yet. In a default
# build the pool cache hands the object back to the next CID of the same
# connection, so two frames carry the same CID, which the client detects
# here. Without the pool cache (ASan, DEBUG_DONT_SHARE_POOLS), freed heap
# memory is sent instead and the sanitizer reports a use-after-free.

haproxy h1 -conf {
    global
        .if feature(THREAD)
            thread-groups 1
            nbthread 1
        .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "quic+fd@${fe}" ssl crt ${testdir}/certs/common.pem alpn h3
        http-request return status 200 content-type text/plain string "ok"
} -start

process p1 "python3 ${testdir}/retired_cid_ncid.py --addr ${h1_fe_addr} --port ${h1_fe_port}" -start
process p1 -expect-text 0 0 "READY"

# The script retires seq 1 and 2 in a single packet, which used to make
# haproxy build a NEW_CONNECTION_ID frame from the quic_connection_id freed
# by the second RETIRE. It must survive (a crash would leave only silence),
# and close the connection with PROTOCOL_VIOLATION since seq 2 was never
# sent (RFC 9000 19.16).
process p1 -expect-text 0 0 "RESULT"

# Surface the driver's own message when it did not succeed, instead of
# leaving only a bare exit status behind.
shell {
    if ! grep -q "RESULT OK" "${p1_out}"; then
        echo "--- p1 stdout ---"; cat "${p1_out}"
        echo "--- p1 stderr ---"; cat "${p1_err}"
        exit 1
    fi
}

process p1 -wait

# haproxy handled the RETIRE storm and is still alive and serving.
haproxy h1 -cli {
    send "show info"
    expect ~ "Name: HAProxy"
}
